# =============================================================================
# PROLOG GRAMMAR (BNF Notation)
# Formal grammar for a subset of Prolog suitable for student code validation
# =============================================================================

# Top-level structure
<program>           ::= <clause_list>
<clause_list>       ::= <clause> <clause_list> | ε

<clause>            ::= <fact> | <rule> | <query>
<fact>              ::= <term> "."
<rule>              ::= <head> ":-" <body> "."
<query>             ::= "?-" <body> "."

# Clause components
<head>              ::= <compound_term>
<body>              ::= <goal> | <goal> "," <body> | <goal> ";" <body>
<goal>              ::= <term>

# Terms
<term>              ::= <variable>
                      | <atom>
                      | <number>
                      | <compound_term>
                      | <list>
                      | <string>
                      | <infix_expr>
                      | "!"          # cut as a standalone goal/term

<compound_term>     ::= <functor> "(" <arguments> ")"
<functor>           ::= <atom>
<arguments>         ::= <term> | <term> "," <arguments>

# Infix expressions (subset)
<infix_expr>        ::= <term> <operator> <term>

# Lists
<list>              ::= "[" "]"
                      | "[" <list_elements> "]"
                      | "[" <list_elements> "|" <term> "]"

<list_elements>     ::= <term> | <term> "," <list_elements>

# Atomic terms
<variable>          ::= <uppercase_letter> <alphanum>*
                      | "_" <alphanum>*

<atom>              ::= <lowercase_letter> <alphanum>*
                      | "'" <quoted_chars> "'"
                      | <special_atom>

<number>            ::= <integer> | <float>
<integer>           ::= <digit>+ | "-" <digit>+
<float>             ::= <digit>+ "." <digit>+ | "-" <digit>+ "." <digit>+

<string>            ::= '"' <string_chars> '"'

# Character classes
<uppercase_letter>  ::= "A" | "B" | ... | "Z"
<lowercase_letter>  ::= "a" | "b" | ... | "z"
<digit>             ::= "0" | "1" | ... | "9"
<alphanum>          ::= <letter> | <digit> | "_"
<letter>            ::= <uppercase_letter> | <lowercase_letter>

# Special atoms (operators and built-ins)
<special_atom>      ::= "[]" | "!" | "true" | "false" | "fail"

# Operators (subset for student code)
<operator>          ::= "is" | "=" | "\\=" | "==" | "\\==" 
                      | "<" | ">" | "=<" | ">="
                      | "+" | "-" | "*" | "/" | "//" | "mod"
                      | "=.." | "\\+"

# Comments (stripped before tokenization)
<comment>           ::= "%" <text_until_newline>
                      | "/*" <text_until_close> "*/"

# =============================================================================
# ERROR PATTERNS TO DETECT
# =============================================================================
#
# Detection is split across two stages in prolog_parser.pl:
#
#   Stage 1 – Structural errors (detected by SWI read_term via
#              swi_structural_check/2 + read_all_terms/1):
#     These are genuine parse errors that prevent the file from loading.
#
#   Stage 2 – Semantic / token-level errors (detected by the tokeniser
#              via detect_token_error/2 after tokenize/2):
#     These are syntactically valid Prolog but almost certainly student
#     mistakes in the context of an educational assignment.
#
# ─────────────────────────────────────────────────────────────────────────────
# STAGE 1: Structural errors (SWI read_term)
# ─────────────────────────────────────────────────────────────────────────────

# 1. Missing period at end of clause  →  error(swi_syntax_error(Msg))
#    factorial(0, 1)
#    factorial(N, F) :- ...    ← first clause has no terminating "."

# 2. Unmatched parentheses  →  error(swi_syntax_error(Msg))
#    factorial(N, R) :- N > 0, factorial(N1, R1.    ← MISSING ")"

# 3. Unmatched brackets  →  error(swi_syntax_error(Msg))
#    append([H|T], L, [H|R) :- append(T, L, R).     ← "]" became ")"

# ─────────────────────────────────────────────────────────────────────────────
# STAGE 2: Semantic / token-level errors (tokeniser)
# ─────────────────────────────────────────────────────────────────────────────
#
# These are tokenised and checked by detect_token_error/2 in
# collect_parse_errors/3.  SWI happily loads these files; the checker
# flags them because they almost always represent a student mistake.

# 4. Invalid operators  →  error(invalid_operator(Op))
#    X := 5      ← should be "X is 5"          (token: invalid_op(':='))
#    X != Y      ← should be "X \\= Y"          (token: invalid_op('!='))
#    X && Y      ← should be "X , Y"            (token: invalid_op('&&'))
#    X || Y      ← should be "X ; Y"            (token: invalid_op('||'))
#
#    BNF constraint (negative):
#    <invalid_op>  ::= ":=" | "!=" | "&&" | "||"
#    Valid code must NOT contain <invalid_op> as an operator token.

# 5. Lowercase identifier used where a variable was intended
#    →  error(lowercase_variable(Atom))
#    factorial(0, 1).
#    factorial(N, f) :- N > 0, N1 is N-1, factorial(N1, F1), f is N*F1.
#                ↑ atom 'f' — must be uppercase variable 'F'
#
#    Detection heuristic (is_likely_variable/1):
#      An atom is flagged if it:
#        (a) starts with a lowercase letter
#        (b) has total length ≤ 3 characters
#        (c) is not a known keyword: is, mod, div, abs, sin, cos, exp,
#                                    log, max, min, true, false, fail
#
#    BNF constraint (contextual):
#    In <clause> head argument positions and on the LHS of "is",
#    <atom> tokens matching is_likely_variable/1 are treated as errors.

# ─────────────────────────────────────────────────────────────────────────────
# Additional heuristic structural patterns (token-count checks)
# ─────────────────────────────────────────────────────────────────────────────

# 6. Missing clause body
#    factorial(N, R) :-.    ← body missing after ":-"

# 7. Dangling comma
#    factorial(N, R) :- N > 0,.    ← trailing comma before period

# =============================================================================
# NOTES
# =============================================================================
# - This grammar is simplified for educational purposes
# - Full Prolog grammar includes many more operators and constructs
# - DCG implementation handles left-recursion and provides better error messages
# - Whitespace is implicit and handled by tokenizer
